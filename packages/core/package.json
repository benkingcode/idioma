{
  "name": "@idioma/core",
  "version": "0.6.0",
  "description": "Compile-time React i18n - build tools and CLI",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/benkingcode/idioma",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/bundler/vite.d.mts",
      "import": "./dist/bundler/vite.mjs",
      "require": "./dist/bundler/vite.mjs"
    },
    "./metro": {
      "types": "./dist/bundler/metro.d.mts",
      "import": "./dist/bundler/metro.mjs",
      "require": "./dist/bundler/metro.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.mjs"
    },
    "./icu": {
      "types": "./dist/icu/index.d.mts",
      "import": "./dist/icu/index.mjs",
      "require": "./dist/icu/index.mjs"
    },
    "./keys": {
      "types": "./dist/keys/generator.d.mts",
      "import": "./dist/keys/generator.mjs",
      "require": "./dist/keys/generator.mjs"
    }
  },
  "bin": {
    "idioma": "./bin/idioma.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "ci-info": "^4.3.1",
    "citty": "^0.1.6",
    "cli-progress": "^3.12.0",
    "fast-glob": "^3.3.3",
    "get-tsconfig": "^4.13.7",
    "gettext-parser": "^10.0.0",
    "ignore": "^7.0.5",
    "jiti": "^2.6.1",
    "magic-string": "^1.4.5",
    "murmurhash-js": "^1.0.0",
    "ora": "^9.0.0",
    "oxc-parser": "^0.157.0",
    "pathe": "^1.1.2",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "metro-config": ">=0.80.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "metro-config": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@babel/core": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@types/babel__core": "^7.20.5",
    "@types/cli-progress": "^3.11.6",
    "@types/gettext-parser": "^4.0.4",
    "@types/murmurhash-js": "^1.0.6",
    "ai": "^6.0.0",
    "vite": "^8.3.5"
  },
  "keywords": [
    "i18n",
    "react",
    "babel",
    "vite",
    "internationalization",
    "localization",
    "translation",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
